# Ignore all MP4 videos in any subfolder
**/*.mp4
**/*.jpg
**/*.jpeg
**/*.webp
**/*.png
**/*.wav
**/*.aup3
**/*.aup3-wal
**/*.aup3-shm
# System files
.DS_Store

# Ignore all folders starting with upscayl_ and everything inside them
**/upscayl_*/

# Ignore the virtual environment folder and its contents
.venv/
venv/
**/backup/

# Large downloadable artifacts — keep out of git (see ARTIFACTS.md)
VoiceModels/
**/*.zip
**/*.pth
**/*.index

# Other bulky media (mp3 stays tracked as final output)
**/*.aiff
**/*.ogg
**/*.m4a
**/*.mkv
**/*.pdf

# Editor/tool caches and backups
**/CacheClip/
**/*.pfl
**/*.bak
**/*.bak2
__pycache__/
**/*.pyc

# Saved web pages
**/*_files/