#!/usr/bin/env bash

set -e  # exit on any error

# ----------------------------
# Validate input
# ----------------------------
if [ -z "$1" ]; then
  echo "Usage: $0 <name>"
  exit 1
fi

name="$1"

audio="${name}.mp3"
video="${name}.mp4"
output="${name}video.mp4"

# ----------------------------
# Check required files
# ----------------------------
if [ ! -f "$audio" ]; then
  echo "Error: Missing audio file: $audio"
  exit 1
fi

if [ ! -f "$video" ]; then
  echo "Error: Missing video file: $video"
  exit 1
fi

echo "🎬 Creating video:"
echo "  Video : $video"
echo "  Audio : $audio"
echo "  Output: $output"

# ----------------------------
# Create final video
# ----------------------------

ffmpeg -y \
  -stream_loop -1 -i "$video" \
  -i "$audio" \
  -map 0:v:0 \
  -map 1:a:0 \
  -c:v copy \
  -c:a aac -b:a 192k \
  -shortest \
  "$output"
echo "✅ Done: $output"

